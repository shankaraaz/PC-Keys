rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 128
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 128;
      allow list, delete: if false;
    }

    // --- PRODUCT RULES ---
    // Anyone can read products. Logged-in admin/users can manage products.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isValidId(productId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 256
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.salePrice is number
        && request.resource.data.salePrice >= 0
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 128;
      allow delete: if isSignedIn() && isValidId(productId);
    }

    // --- ORDER RULES ---
    // Users can create orders for themselves, and view their own orders.
    // Orders are immutable after creation.
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && isValidId(orderId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 128
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.status is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- SEARCH LOG RULES ---
    // Anyone can create search logs for analytics, but no one can read, update, or delete them.
    match /search_logs/{logId} {
      allow create: if request.resource.data.query is string
        && request.resource.data.query.size() <= 256
        && request.resource.data.resultCount is number
        && request.resource.data.resultCount >= 0;
      allow read, update, delete: if false;
    }
  }
}
